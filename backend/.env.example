# ==========================================
# Application
# ==========================================

ENVIRONMENT=development
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SAMESITE=lax


# ==========================================
# Database
# ==========================================

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_document_assistant


# ==========================================
# Authentication
# ==========================================

GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

JWT_SECRET_KEY=generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080


# ==========================================
# DeepSeek / LLM
# ==========================================

DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

LLM_TIMEOUT_SECONDS=90


# ==========================================
# DataLab
# ==========================================

DATALAB_API_KEY=replace-me


# ==========================================
# Uploads
# ==========================================

MAX_UPLOAD_SIZE_MB=50


# ==========================================
# Embeddings
# ==========================================

EMBEDDING_BATCH_SIZE=32


# ==========================================
# Background Tasks / Celery
# ==========================================

TASK_QUEUE=background

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

MAX_QUESTION_LENGTH=4000
MAX_SEARCH_QUERY_LENGTH=1000

LLM_MAX_OUTPUT_TOKENS=3000
LLM_MAX_CONTEXT_CHARS=60000
LLM_MAX_HISTORY_MESSAGES=10
LLM_MAX_HISTORY_MESSAGE_CHARS=6000
LLM_MAX_TOTAL_HISTORY_CHARS=20000

# ==========================================
# Shared resource admission (all environments)
# ==========================================
# Redis is required. No in-memory or silently disabled fallback.
# Can use the existing Redis service; use a separate DB from Celery if desired.
RESOURCE_REDIS_URL=redis://127.0.0.1:6379/2

RESOURCE_API_LIMIT=120
RESOURCE_API_WINDOW_SECONDS=60
RESOURCE_AUTH_LIMIT=30
RESOURCE_AUTH_WINDOW_SECONDS=60
RESOURCE_RECOVERY_LIMIT=30
RESOURCE_RECOVERY_WINDOW_SECONDS=60
RESOURCE_SEARCH_LIMIT=20
RESOURCE_SEARCH_WINDOW_SECONDS=60
RESOURCE_CHAT_LIMIT=10
RESOURCE_CHAT_WINDOW_SECONDS=60
RESOURCE_UPLOAD_LIMIT=5
RESOURCE_UPLOAD_WINDOW_SECONDS=3600
RESOURCE_SUMMARY_LIMIT=3
RESOURCE_SUMMARY_WINDOW_SECONDS=3600

# PostgreSQL session permits; direct connections/session pooling required.
RESOURCE_CHAT_CONCURRENCY=2
RESOURCE_SEARCH_CONCURRENCY=2
RESOURCE_SUMMARY_CONCURRENCY=1
RESOURCE_PROCESSING_CONCURRENCY=1
RESOURCE_MAX_DOCUMENTS=100
RESOURCE_MAX_ORIGINAL_BYTES=1073741824
