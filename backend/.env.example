# ==========================================
# Application
# ==========================================

ENVIRONMENT=development
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SAMESITE=lax


# ==========================================
# Database
# ==========================================

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_document_assistant


# ==========================================
# Authentication
# ==========================================

GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

JWT_SECRET_KEY=generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080


# ==========================================
# DeepSeek / LLM
# ==========================================

DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

LLM_TIMEOUT_SECONDS=90


# ==========================================
# DataLab
# ==========================================

DATALAB_API_KEY=replace-me


# ==========================================
# Uploads
# ==========================================

MAX_UPLOAD_SIZE_MB=50


# ==========================================
# Embeddings
# ==========================================

EMBEDDING_BATCH_SIZE=32


# ==========================================
# Background Tasks / Celery
# ==========================================

TASK_QUEUE=background

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

MAX_QUESTION_LENGTH=4000
MAX_SEARCH_QUERY_LENGTH=1000

LLM_MAX_OUTPUT_TOKENS=3000
LLM_MAX_CONTEXT_CHARS=60000
LLM_MAX_HISTORY_MESSAGES=10
LLM_MAX_HISTORY_MESSAGE_CHARS=6000
LLM_MAX_TOTAL_HISTORY_CHARS=20000