# ==========================================
# Application
# ==========================================

ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
# Secure defaults to true in production/staging, false in development/test.
# Optional COOKIE_SECURE=true; false is rejected in production/staging.
COOKIE_SAMESITE=lax
# Cross-site deployments require none + Secure; state always uses Lax.
# See docs/authentication-sessions.md before changing browser-facing origins.


# ==========================================
# Database
# ==========================================

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_document_assistant


# ==========================================
# Authentication
# ==========================================

GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
# Needed for redirect login; load the real secret through deployment configuration.
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

JWT_SECRET_KEY=generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# One session lifetime: JWT duration and auth-cookie Max-Age both derive from this.


# ==========================================
# DeepSeek / LLM
# ==========================================

DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

LLM_TIMEOUT_SECONDS=90


# ==========================================
# DataLab
# ==========================================

DATALAB_API_KEY=replace-me
# Used for private extracted images and, in production/staging, authenticated
# raw original documents shared by the web service and Celery worker.
CLOUDINARY_URL=cloudinary://api-key:api-secret@cloud-name


# ==========================================
# Uploads
# ==========================================

MAX_UPLOAD_SIZE_MB=50
# Binary units: 50 MiB file + 1 MiB multipart overhead = 51 MiB request.
# Also configure the production edge/proxy body limit; see docs/upload-resource-limits.md.
MAX_MULTIPART_OVERHEAD_BYTES=1048576
MAX_PDF_PAGES=500
DATALAB_BATCH_SIZE=20
MAX_DATALAB_PAGES_PER_DOCUMENT=40
DATALAB_PARALLEL_BATCHES=2
MAX_DATALAB_RESPONSE_BYTES=33554432
MAX_OFFICE_ZIP_ENTRIES=1000
MAX_OFFICE_EXPANDED_BYTES=209715200
MAX_OFFICE_ENTRY_BYTES=33554432
MAX_OFFICE_COMPRESSION_RATIO=200
MAX_OFFICE_XML_NODES=2000000
MAX_OFFICE_XML_DEPTH=64
MAX_XLSX_WORKSHEETS=20
MAX_XLSX_ROWS_PER_SHEET=20000
MAX_XLSX_TOTAL_ROWS=50000
MAX_XLSX_COLUMNS=256
MAX_XLSX_CELLS=500000
MAX_DOCX_PARAGRAPHS=20000
MAX_DOCX_TABLES=1000
MAX_EXTRACTED_CHARACTERS=2000000
MAX_EXTRACTED_TEXT_BYTES=8388608
MAX_EXTRACTED_BLOCKS=10000
MAX_DOCUMENT_CHUNKS=10000
MAX_PDF_PAGE_CONTENT_BYTES=8388608
MAX_PDF_CONTENT_BYTES=67108864


# ==========================================
# Embeddings
# ==========================================

EMBEDDING_BATCH_SIZE=32


# ==========================================
# Background Tasks / Celery
# ==========================================

# Required explicitly in production/staging. Use background only for a single
# web-service process; use celery when a separate durable worker is running.
TASK_QUEUE=background

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

MAX_QUESTION_LENGTH=4000
MAX_SEARCH_QUERY_LENGTH=1000

LLM_MAX_OUTPUT_TOKENS=3000
LLM_MAX_CONTEXT_CHARS=60000
LLM_MAX_HISTORY_MESSAGES=10
LLM_MAX_HISTORY_MESSAGE_CHARS=6000
LLM_MAX_TOTAL_HISTORY_CHARS=20000

# ==========================================
# Shared resource admission (all environments)
# ==========================================
# Redis is required. No in-memory or silently disabled fallback.
# Can use the existing Redis service; use a separate DB from Celery if desired.
RESOURCE_REDIS_URL=redis://127.0.0.1:6379/2

RESOURCE_API_LIMIT=120
RESOURCE_API_WINDOW_SECONDS=60
RESOURCE_AUTH_LIMIT=30
RESOURCE_AUTH_WINDOW_SECONDS=60
RESOURCE_RECOVERY_LIMIT=30
RESOURCE_RECOVERY_WINDOW_SECONDS=60
RESOURCE_SEARCH_LIMIT=20
RESOURCE_SEARCH_WINDOW_SECONDS=60
RESOURCE_CHAT_LIMIT=10
RESOURCE_CHAT_WINDOW_SECONDS=60
RESOURCE_UPLOAD_LIMIT=5
RESOURCE_UPLOAD_WINDOW_SECONDS=3600
RESOURCE_SUMMARY_LIMIT=3
RESOURCE_SUMMARY_WINDOW_SECONDS=3600

# PostgreSQL session permits; direct connections/session pooling required.
RESOURCE_CHAT_CONCURRENCY=2
RESOURCE_SEARCH_CONCURRENCY=2
RESOURCE_SUMMARY_CONCURRENCY=1
RESOURCE_PROCESSING_CONCURRENCY=1
RESOURCE_MAX_DOCUMENTS=100
RESOURCE_MAX_ORIGINAL_BYTES=1073741824
