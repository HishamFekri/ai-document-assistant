[Unit]
Description=AI Document Assistant deployment executor (root; re-verifies every gate)
Documentation=file:///opt/ai-document-assistant-deploy/README.md
# Requisite, not Requires: never start (or restart) Docker Engine from here.
Requisite=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/storage

[Service]
Type=oneshot
# Runs as root, the default for system services. Root is required to use the
# Docker socket (Docker access is root-equivalent either way). Git runs as the
# checkout's owner; see README "Privileges".
#
# Do NOT set User= here, not even User=root. In systemd v255 (Ubuntu 24.04),
# an explicit User= together with any seccomp-based option below (for example
# RestrictNamespaces=, LockPersonality=) takes the keep_seccomp_privileges
# path in src/core/exec-invoke.c. After the user switch, that path calls
# drop_capability(CAP_SETUID) unless CAP_SETUID is in AmbientCapabilities=.
# With NoNewPrivileges=yes, execve() cannot regain it, so the process ends up
# with CAP_SETUID in CapBnd but not in CapEff, and dropping to the checkout
# owner fails with EPERM at setreuid(). Leaving User= unset keeps the uid
# unset in systemd and skips that path. All restrictions below are unchanged.
ExecStart=/usr/bin/python3 -I /opt/ai-document-assistant-deploy/autodeploy.py --config /etc/ai-document-assistant-deploy/deploy.conf run
# Covers git, two storage checks, the build, both health waits and a rollback.
TimeoutStartSec=55min
SuccessExitStatus=75

StateDirectory=ai-document-assistant-deploy
StateDirectoryMode=0700
Environment=HOME=/var/lib/ai-document-assistant-deploy
Environment=DOCKER_CONFIG=/var/lib/ai-document-assistant-deploy/docker
#LoadCredential=github-token:/etc/ai-document-assistant-deploy/github-token

UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
# No PrivateDevices: the SSD UUID check may need /dev/disk/by-uuid.
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/storage/projects/ai-document-assistant
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# SETUID/SETGID: drop to the checkout owner for git. KILL: stop that git on
# timeout. DAC_READ_SEARCH: read .env, compose.yaml and candidate.json without
# changing their permissions. Nothing else.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_KILL CAP_DAC_READ_SEARCH
AmbientCapabilities=
