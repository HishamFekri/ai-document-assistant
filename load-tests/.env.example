# Documentation only: no tool auto-loads .env files. Set reviewed values in your shell.
# This deliberately non-routable example is for validation/inspection, not a target.
LOAD_BASE_URL=https://api.staging.example.test
LOAD_CONFIRMED_ORIGIN=https://api.staging.example.test
LOAD_ALLOWED_HOST=api.staging.example.test
LOAD_TARGET_IP=192.0.2.10
LOAD_ENVIRONMENT=staging
LOAD_TARGET_ACK=dedicated-non-production-stack
LOAD_SCENARIO=reads
LOAD_PROFILE=smoke
LOAD_USER_MODE=per-vu
LOAD_CREDENTIALS_ACK=dedicated-test-accounts-no-production-tokens
# Set exactly one: LOAD_USERS_JSON or LOAD_USERS_FILE=private/users.json
# JSON shape: [{"token":"DEDICATED_TEST_TOKEN","user_id":1,"chat_id":1,"document_id":1}]
LOAD_PAGE_SIZE=50
LOAD_MAX_PAGES=10
LOAD_THINK_SECONDS=1
# Defaults: ordinary 10000, admission 100, provider-heavy 20. Ceilings are enforced.
# LOAD_MAX_REQUESTS=10000
# LOAD_RAMP_SECONDS=30
# LOAD_HOLD_SECONDS=30
# Optional ordinary-only, after recording a baseline: LOAD_P95_MS=...

# Required for admission probes and mock/real provider scenarios:
LOAD_PROVIDER_MODE=blocked
# LOAD_PROVIDER_GUARD_ACK=isolated-egress-and-fixtures-reviewed
# Chat writes synthetic messages even when providers are mocked:
# LOAD_WRITE_ACK=synthetic-chat-messages-only
# Real search/chat requires BOTH real mode and the independent spending opt-in:
# LOAD_ENABLE_PAID_PROVIDERS=I-accept-provider-spending

# Never set for validate/inspect. Explicit live execution opt-in:
# LOAD_EXECUTION_ACK=run-against-isolated-stack

# Local alternative: use 127.0.0.1:18000 with a dedicated disposable stack only.
# LOAD_ENVIRONMENT=isolated-local
# LOAD_LOCAL_ACK=dedicated-stack-no-production-tunnel
